<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.taurunium.daysix.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_workout_graph"
            app:destination="@id/workout_graph" />
    </fragment>

    <navigation
        android:id="@+id/workout_graph"
        app:startDestination="@id/counterFragment">

        <fragment
            android:id="@+id/counterFragment"
            android:name="com.taurunium.daysix.fragments.CounterFragment"
            android:label="Counter"
            tools:layout="@layout/fragment_counter">

            <action
                android:id="@+id/action_counterFragment_to_instructionsFragment"
                app:destination="@id/instructionsFragment" />
            <action
                android:id="@+id/action_counterFragment_to_targetEditorFragment"
                app:destination="@id/targetEditorFragment" />
        </fragment>

        <fragment
            android:id="@+id/instructionsFragment"
            android:name="com.taurunium.daysix.fragments.InstructionsFragment"
            android:label="Instructions"
            tools:layout="@layout/fragment_instructions">

            <argument
                android:name="repCount"
                app:argType="integer"
                android:defaultValue="0" />
        </fragment>

        <fragment
            android:id="@+id/targetEditorFragment"
            android:name="com.taurunium.daysix.fragments.TargetEditorFragment"
            android:label="TargetEditor"
            tools:layout="@layout/fragment_target_editor">

            <argument
                android:name="initialTarget"
                app:argType="integer" />


        </fragment>

    </navigation>
</navigation>